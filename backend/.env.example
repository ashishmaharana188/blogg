# Database credentials must be configured in the host's secret/environment settings.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DB_NAME=blogg
DB_USER=<postgres-user>
DB_HOST=<postgres-host>
DB_NAME=blogg
DB_PASSWORD=<postgres-password>
DB_PORT=5432

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Set these to strong, unique values for production.
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=30d
AUTH_COOKIE_MAX_AGE_MS=2592000000
# Use "none" only for cross-site frontend/backend deployments over HTTPS.
AUTH_COOKIE_SAME_SITE=lax
NODE_ENV=production
FRONTEND_URL=https://www.example.com

# Only this account can modify site content. Must match the administrator user email.
ADMIN_EMAIL=admin@example.com
# Set true only temporarily to create the admin account, then set false.
ENABLE_ADMIN_REGISTRATION=false
