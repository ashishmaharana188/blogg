{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/share/account",
      "destination": "https://blogg-api-m785.onrender.com/share/account"
    },
    {
      "source": "/share/:bloggId",
      "destination": "https://blogg-api-m785.onrender.com/share/:bloggId"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
